ffuf_to_tsv() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: ffuf-to-tsv <ffuf.json> [output.tsv]" >&2
    return 2
  fi

  local input_file="$1"
  local output_file="${2:-${input_file%.json}.tsv}"
  local temp_file

  if [ ! -r "$input_file" ]; then
    echo "Input is not readable: $input_file" >&2
    return 1
  fi
  if [ "$input_file" = "$output_file" ]; then
    echo "Input and output must be different files." >&2
    return 1
  fi

  temp_file="$(mktemp "${output_file}.tmp.XXXXXX")" || return 1
  if jq -r '
    ["host","status","length","words","lines","url"],
    (.results[] | [.host, .status, .length, .words, .lines, .url])
    | @tsv
  ' "$input_file" > "$temp_file"; then
    mv "$temp_file" "$output_file"
    echo "TSV output: $output_file"
  else
    rm -f "$temp_file"
    return 1
  fi
}

ffuf_smart_filter() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: ffuf-smart-filter <input.tsv> [output.tsv]" >&2
    return 2
  fi

  local input_file="$1"
  local output_file="${2:-${input_file%.tsv}_smart.tsv}"

  if [ ! -r "$input_file" ]; then
    echo "Input is not readable: $input_file" >&2
    return 1
  fi
  if [ "$input_file" = "$output_file" ]; then
    echo "Input and output must be different files." >&2
    return 1
  fi

  python3 /opt/tools/FFUF-Smart-Filter/ffuf_smart_filter.py \
    "$input_file" \
    -o "$output_file" \
    --header \
    --write-header && echo "Filtered TSV output: $output_file"
}
