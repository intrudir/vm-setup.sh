    return 2
  fi

  local target_input="$1"
  local wordlist="$TOOLS_DIR/wordlists/contentdiscovery/custom/intrudir.txt"
  local extensions=".html,.htm,.json,.old,.bak,.tmp,.conf,.yml,.yaml,.log,.xml,.env,.config"
  shift

