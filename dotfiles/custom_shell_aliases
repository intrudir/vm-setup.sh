# ffuf workflows
_ffuf_scan() {
  if [ "$#" -lt 3 ]; then
    echo "Usage: _ffuf_scan <wordlist> <scan-name> <url> [ffuf options...]" >&2
    return 2
  fi

  local wordlist="$1"
  local scan_name="$2"
  local target_url="$3"
  shift 3

  if [ ! -r "$wordlist" ]; then
    echo "Wordlist is not readable: $wordlist" >&2
    return 1
  fi

  case "$target_url" in
    *FUZZ*) ;;
    *) target_url="${target_url%/}/FUZZ" ;;
  esac

  local authority="${target_url#*://}"
  authority="${authority%%/*}"
  authority="${authority%%\?*}"
  authority="${authority%%\#*}"

  local safe_host
  safe_host="$(printf '%s' "$authority" | tr -c '[:alnum:].-' '_')"

  local output_file="${safe_host}_${scan_name}_$(date +%Y%m%d_%H%M%S).json"
  local browser_ua="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"

  echo "ffuf target: $target_url"
  echo "JSON output: $output_file"

  command ffuf \
    -c \
    -w "$wordlist" \
    -of json \
    -o "$output_file" \
    -u "$target_url" \
    -rate 500 \
    -H "User-Agent: $browser_ua" \
    "$@"
}

ffuf_swagger() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: ffs <url[/FUZZ] | hosts-file> [ffuf options...]" >&2
    return 2
  fi

  local target_input="$1"
  local wordlist="$TOOLS_DIR/wordlists/apis/swagger/all_my_swagger.txt"
  shift

  case "$target_input" in
    http://*|https://*)
      _ffuf_scan "$wordlist" swagger "$target_input" "$@"
      ;;
    *)
      if [ ! -f "$target_input" ] || [ ! -r "$target_input" ]; then
        echo "Hosts file is not readable: $target_input" >&2
        return 1
      fi
      if [ ! -r "$wordlist" ]; then
        echo "Wordlist is not readable: $wordlist" >&2
        return 1
      fi
      command ffuf -c \
        -w "$target_input:W1" \
        -w "$wordlist:W2" \
        -u 'W1/W2' \
        -of json -o swagger_out.json \
        -rate 500 \
        -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36" \
        "$@"
      ;;
  esac
}

